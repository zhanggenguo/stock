<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net46</TargetFramework>
    <AssemblyName>StockQuery.WinForms</AssemblyName>
    <RootNamespace>StockQuery.WinForms</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Windows.Forms.DataVisualization" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net46" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 让 VS 把 Designer.cs 嵌套到对应窗体下，并识别为可设计的 Form -->
  <ItemGroup>
    <Compile Update="MainForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="MainForm.Designer.cs">
      <DependentUpon>MainForm.cs</DependentUpon>
    </Compile>
    <Compile Update="DetailForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="DetailForm.Designer.cs">
      <DependentUpon>DetailForm.cs</DependentUpon>
    </Compile>
    <Compile Update="InfoSourceForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="InfoSourceForm.Designer.cs">
      <DependentUpon>InfoSourceForm.cs</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
